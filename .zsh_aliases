
alias ez="eza --long --all --icons=always --group-directories-first --header --git --total-size"
alias l="eza --oneline --icons=always --all --group-directories-first"
alias vsc="code ."
alias nvi="nvim ."
alias dj="python manage.py"
alias lgit="lazygit"
alias sysupd="sudo nala update && sudo nala upgrade"
alias brewup="brew update && brew upgrade && brew autoremove"
alias avenv="source .venv/bin/activate"
